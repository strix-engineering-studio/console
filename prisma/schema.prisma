generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid()) @map("_id")
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  website     String?
  industry    String?
  description String?
  location    String?
  country     String?
  city        String?
  linkedinUrl String?
  people      Person[]
  leads       Lead[]
  research    ResearchRun[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Person {
  id             String       @id @default(uuid()) @map("_id")
  name           String
  email          String?
  phone          String?
  title          String?
  linkedinUrl    String?
  location       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  research       ResearchRun[]
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([name])
  @@index([email])
}

model Lead {
  id             String       @id @default(uuid()) @map("_id")
  name           String
  status         LeadStatus   @default(NEW)
  source         LeadSource   @default(MANUAL)
  notes          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  personId       String?
  person         Person?      @relation(fields: [personId], references: [id])
  research       ResearchRun[]
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([name])
}

model ResearchRun {
  id             String       @id @default(uuid()) @map("_id")
  status         ResearchStatus @default(PENDING)
  summary        String?
  provider       String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  personId       String?
  person         Person?      @relation(fields: [personId], references: [id])
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model Activity {
  id             String       @id @default(uuid()) @map("_id")
  type           String
  title          String
  description    String?
  sourceUrl      String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  personId       String?
  person         Person?      @relation(fields: [personId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([createdAt])
}

model McpApiKey {
  id         String    @id @default(uuid()) @map("_id")
  name       String
  keyHash    String    @unique
  keyPrefix  String?
  scopes     String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
}

model McpIdempotency {
  id        String   @id @default(uuid()) @map("_id")
  tool      String
  key       String
  requestHash String
  resultJson String?
  createdAt DateTime @default(now())

  @@unique([tool, key])
}

model McpOAuthClient {
  id                       String   @id @default(uuid()) @map("_id")
  clientId                 String   @unique
  clientName               String
  redirectUris             String[]
  grantTypes               String[]
  responseTypes            String[]
  tokenEndpointAuthMethod  String?  @default("none")
  scopes                   String?  @default("strix:read strix:write")
  revokedAt                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime? @updatedAt
}

model McpOAuthRequest {
  id            String   @id @default(uuid()) @map("_id")
  adminId       String
  clientId      String
  redirectUri   String
  state         String?
  codeChallenge String
  scopes        String
  resource      String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model McpOAuthAuthorizationCode {
  id            String   @id @default(uuid()) @map("_id")
  codeHash      String   @unique
  adminId       String
  clientId      String
  redirectUri   String
  codeChallenge String
  scopes        String
  resource      String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model McpOAuthToken {
  id        String    @id @default(uuid()) @map("_id")
  tokenHash String    @unique
  tokenType String
  adminId   String
  clientId  String
  scopes    String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, tokenType, expiresAt])
}

enum LeadStatus {
  NEW
  RESEARCHING
  ENGAGED
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum LeadSource {
  MANUAL
  RESEARCH
  REFERRAL
  WEBSITE
  LINKEDIN
  OTHER
}

enum ResearchStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}
